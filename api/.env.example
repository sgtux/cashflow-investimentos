# Copie para .env (nao versionado) e ajuste. application.yml faz o import automatico deste arquivo.
# Ver ../docs/api-especificacao.md secao 7.

# Connection string JDBC do banco de investimentos (banco proprio e separado do Cashflow).
DATABASE_URL=jdbc:sqlserver://localhost:1434;databaseName=cashflow_investimentos;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=sa
DATABASE_PASSWORD=Invest@Local123

# DEVE ser exatamente a mesma string configurada no app .NET do Cashflow (>= 32 chars ASCII).
# E isso que estabelece a confianca entre os dois servicos.
SECRET_JWT_KEY=troque-por-exatamente-a-mesma-string-do-dotnet-min-32-chars

# URL da API .NET do Cashflow (alvo do proxy de login POST /api/token).
CASHFLOW_API_BASE_URL=http://localhost:56666

# Origem do frontend (web/), para CORS.
WEB_ORIGIN=http://localhost:3001

# Integracao de cotacao (brapi.dev) - usada a partir do passo 4. Verifique o schema real antes de implementar.
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_API_TOKEN=
QUOTE_CACHE_TTL_MINUTES=10

# Porta HTTP da API.
SERVER_PORT=8080
